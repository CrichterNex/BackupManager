APP_NAME=BMS
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MariaDB / MySQL (XAMPP). Create the database and a user first, see README.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bms
DB_USERNAME=bms
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Test engine (runs every minute from the scheduler)
BMS_ENGINE_ENABLED=true
BMS_RANDOM_RESTORE_EVERY_DAYS=7
BMS_TEST_RETRY_DELAY_MINUTES=60
BMS_TEST_MAX_ATTEMPTS=3
# Where restore tests copy files to. Empty means the system temp folder.
BMS_RESTORE_STAGING_DIR=
BMS_RATE_LIMIT_PER_HOUR=1000
BMS_LOGIN_ATTEMPTS_PER_15_MIN=10
